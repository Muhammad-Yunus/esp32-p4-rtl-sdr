# ESP32-P4-WIFI6-Touch-LCD-4B (32 MB flash, 32 MB PSRAM) + RTL-SDR V3.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Chip revision: these defaults build for ESP32-P4 v3.x. Early kits report "revision v1.0"
# (esptool) and need sdkconfig.rev1 on top; tools/build_release.sh builds both.

# 32 MB PSRAM: IQ ring, waterfall history. Small allocations stay internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# The four USB-A ports sit behind the kit's CH334F hub on the P4's high-speed USB-OTG.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Wi-Fi and BLE scanners: currently stubbed. The 4B uses an ESP32-C6 over SDIO
# (esp_hosted); these BT settings are kept for when the hosted controller is wired in.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
